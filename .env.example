# Cliente Firebase (públicas por diseño — ver docs/DIRECTRICES.md D-04)
# Obtén estos valores en: Firebase Console → Configuración del proyecto → Tus apps → Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Nota: el Admin SDK (FIREBASE_CLIENT_EMAIL, FIREBASE_ADMIN_PRIVATE_KEY) no se
# usa en esta versión — toda la interacción con Firestore es desde el cliente.
