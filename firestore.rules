rules_version = '2';

// Deniega todo por defecto (DIRECTRICES D-05). Cada colección nueva añade
// aquí su propia regla explícita en el MISMO commit que la empieza a usar.
service cloud.firestore {
  match /databases/{database}/documents {

    // --- hogares/{hogarId} ---
    // Solo los miembros del hogar pueden leerlo o escribirlo.
    match /hogares/{hogarId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid in resource.data.miembros;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.miembros;

      // --- hogares/{hogarId}/gastos/{gastoId} ---
      match /gastos/{gastoId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/hogares/$(hogarId)).data.miembros;
      }
    }

    // Nada más es accesible. Si se añade una colección nueva, su regla va
    // aquí, no un comodín abierto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
