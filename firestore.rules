rules_version = '2';

// Sin autenticación: la "protección" es la aleatoriedad del UUID del hogarId.
// Cualquiera que conozca el hogarId puede leer y escribir sus datos.
// Decisión de diseño explícita para prueba de concepto — ver docs/DIRECTRICES.md D-05.
service cloud.firestore {
  match /databases/{database}/documents {

    // --- hogares/{hogarId} ---
    // Acceso abierto para quien conozca el hogarId (UUID aleatorio).
    // El documento tiene: nombre (string), miembros (string[]), categorias (string[]).
    match /hogares/{hogarId} {
      allow read, write: if true;

      // --- hogares/{hogarId}/gastos/{gastoId} ---
      // Mismo criterio: acceso abierto para quien conozca el hogarId.
      match /gastos/{gastoId} {
        allow read, write: if true;
      }
    }

    // Todo lo demás denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
